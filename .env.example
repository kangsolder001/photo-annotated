# Hanya untuk test integrasi (go test). Aplikasi sendiri tidak memakai .env: semua konfigurasi dan
# secret ada di config.json (lihat config.json.example).
# Salin ke .env.local (di-gitignore), jalankan scripts/db-tunnel.sh lalu:
#   set -a; . ./.env.local; set +a; go test ./... -race
TEST_DATABASE_URL=postgres://photo_annotated_test:CHANGE_ME@127.0.0.1:15432/photo_annotated_test?sslmode=disable
