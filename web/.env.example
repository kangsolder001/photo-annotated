# Salin ke .env.local untuk pengembangan. Semua nilai VITE_* masuk ke bundle (publik), jangan isi rahasia.
# URL dasar API tanpa garis miring akhir. Kosong = origin yang sama (dev memakai proxy Vite ke VITE_DEV_API_TARGET).
VITE_API_BASE_URL=
# Mode auth API: none | otp (harus sama dengan auth.mode di config.json API)
VITE_AUTH_MODE=otp
# Site key Cloudflare Turnstile (kosong = tanpa Turnstile, harus cocok dengan turnstile.enabled di API)
VITE_TURNSTILE_SITE_KEY=
# Hanya dev: ke mana proxy /api diteruskan (mis. SSH tunnel ke Pi: http://127.0.0.1:8080)
VITE_DEV_API_TARGET=http://127.0.0.1:8080
